# ============================================================
#  本地数据 / 个人隐私 —— 一律不入库
#  user_data.json 里是所有本地账号的标注（星标/标签/状态/大小号），
#  export / backup 里是收藏、UID、下载记录，都属于个人数据。
# ============================================================
browser/data/
browser/backup/
browser/export/
browser/cache/
browser/recycle-bin/
browser/.workbuddy/

# 个人过程记录（下载日志、账号清单、改名报告）—— 归档到 _archive/，整体不上传
_archive/

# ============================================================
#  浏览器扩展的运行时文件
# ============================================================
douyin-author-marker/local-service/config.json
douyin-author-marker/local-service/pending-queue.json
douyin-author-marker/local-service/service.log

# ============================================================
#  AI 助手 / 调试过程产物
# ============================================================
.workbuddy/

# 抖音接口可行性探测脚本：一次性、写死了本机绝对路径和登录账号 uid，不入库
# （probe_latest.py 是早期入库的，不受影响 —— 已被跟踪的文件不会被 ignore 规则移除）
browser/tools/probe_*.py

# 重复核对的过程产物：里面是真实昵称、UID 目录名、本机文件路径，只在本地用
browser/tools/dup_candidates*.json
browser/tools/dup_visual_result.json
browser/tmp/

# ============================================================
#  Python
# ============================================================
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ============================================================
#  杂项
# ============================================================
*.log
*.tmp
*.bak
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store
